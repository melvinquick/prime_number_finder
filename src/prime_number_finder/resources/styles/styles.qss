/* =========================================
   UNIVERSAL BASE (DO NOT EDIT PER APP)
   ========================================= */

QWidget {
    background-color: {{background-color}};
    color: {{color}};
    font-family: "{{font-family}}";
    font-size: {{font-size-base}};
}

QMainWindow, QDialog {
    background-color: {{background-color}};
}

QToolTip {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
}

QLabel {
    background: transparent;
    color: {{color}};
}

QMenuBar {
    background-color: {{surface-color}};
    color: {{color}};
    border-bottom: {{border}};
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: {{border-radius}};
}

QMenuBar::item:selected {
    background-color: {{widget-background-color}};
}

QMenu {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: {{border-radius}};
}

QMenu::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QFrame#Card, QFrame#Section {
    background-color: {{surface-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

QLabel#DialogTitle {
    font-size: {{font-size-lg}};
    font-weight: 700;
    color: {{color}};
}

QLabel#MutedLabel {
    color: {{muted-color}};
    font-size: {{font-size-base}};
}

QLabel#ResultSuccess { color: {{success-color}}; font-weight: bold; font-size: {{font-size-lg}}; }
QLabel#ResultDanger  { color: {{danger-color}};  font-weight: bold; font-size: {{font-size-lg}}; }
QLabel#ResultNeutral { color: {{accent-color}}; font-weight: bold; font-size: {{font-size-lg}}; }

QPushButton {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
    min-height: 24px;
}

QPushButton:hover {
    border-color: {{accent-color}};
}

QPushButton:pressed {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QPushButton#PrimaryButton {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
    border: 1px solid {{accent-color}};
    font-weight: 700;
    padding: 12px 16px;
    font-size: {{font-size-lg}};
}

QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover-color}};
    border-color: {{accent-hover-color}};
}

QLineEdit, QComboBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid {{accent-color}};
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
    outline: none;
}